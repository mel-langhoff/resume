<div class="chip-wrapper">
  <div class="chip-stage">

    <%= image_tag "chips.png", class: "chip-img" %>

    <%= link_to root_path, class: "chip-back-btn", data: { turbo: false } %>

    <div class="chip-textbox">

      <h2>Resume</h2>

      <% @jobs.each do |job| %>
        <div class="job-card">

          <p>
            <strong><%= job.company %></strong> |
            <%= job.location %> |
            <%= job.formatted_start_date %> - <%= job.formatted_end_date %>
          </p>

          <p><%= job.title %></p>
          <p><%= job.description %></p>

        </div>
      <% end %>

    </div>

  </div>
</div>