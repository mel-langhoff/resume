<% content_for :full_screen do %>
<div class="chip-wrapper">

  <%= image_tag "chips.png", class: "chip-img" %>

  <!-- 🔥 BACK BUTTON -->
  

  <div class="chip-textbox">
  <%= link_to root_path, class: "chip-back-btn" do %>
<% end %>

    <h2>Resume</h2>

    <% @jobs.each do |job| %>
      <div class="job-card">

        <p class="job-header">
          <strong><%= job.company %></strong> |
          <%= job.location %> |
          <%= job.formatted_start_date %> - <%= job.formatted_end_date %>
        </p>

        <p class="job-title"><%= job.title %></p>

        <p class="job-desc"><%= job.description %></p>

        <ul>
          <% job.responsibilities.each do |resp| %>
            <li><%= resp %></li>
          <% end %>
        </ul>

      </div>
    <% end %>

  </div>

</div>
<% end %>