<% content_for :full_screen do %>

<div class="machine-wrapper full-screen">

  <%= image_tag "vending_machine.png", class: "machine-img" %>

  <div class="machine-ui">

    <%= link_to root_path,
      class: "machine-btn",
      data: { key: "home", turbo: false } %>

    <%= link_to bio_path,
      class: "machine-btn",
      data: { key: "about", turbo: false } %>

    <%= link_to resume_path,
      class: "machine-btn",
      data: { key: "resume", turbo: false } %>

    <%= link_to projects_path,
      class: "machine-btn",
      data: { key: "projects", turbo: false } %>

    <%= link_to "mailto:mlanghoff@uwalumni.com",
      class: "machine-btn",
      data: { key: "contact" } %>

    <!-- 🔥 EXTERNAL LINKS -->
    <%= link_to "https://github.com/mel-langhoff",
      target: "_blank",
      rel: "noopener",
      class: "machine-btn",
      data: { key: "github", turbo: false } %>

    <%= link_to "https://linkedin.com/in/melissalanghoff",
      target: "_blank",
      rel: "noopener",
      class: "machine-btn",
      data: { key: "linkedin", turbo: false } %>

    <%= link_to "https://topshelf.mel-langhoff.com",
      target: "_blank",
      rel: "noopener",
      class: "machine-btn",
      data: { key: "topshelf", turbo: false } %>

  </div>

  <div id="bottle-layer"></div>

</div>

<% end %>