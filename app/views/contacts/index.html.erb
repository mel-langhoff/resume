<% content_for :full_screen do %>

<div class="chip-wrapper">

  <div class="chip-stage">

    <%= image_tag "chips.png", class: "chip-img" %>

    <%= link_to root_path, class: "chip-back-btn", data: { turbo: false } %>

    <div class="chip-textbox">

      <h2>Contact</h2>

      <%= form_with url: contacts_path, method: :post, local: true do |f| %>

        <div class="form-group">
          <%= f.label :name %>
          <%= f.text_field :name %>
        </div>

        <div class="form-group">
          <%= f.label :email %>
          <%= f.email_field :email %>
        </div>

        <div class="form-group">
          <%= f.label :message %>
          <%= f.text_area :message %>
        </div>

        <%= f.submit "Send", class: "btn" %>

      <% end %>

    </div>

  </div>

</div>

<% end %>