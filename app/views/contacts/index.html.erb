<div class="content-box">

  <h2>Contact</h2>

  <%= form_with url: contacts_path, method: :post, local: true do |f| %>

    <div class="form-group">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :message %>
      <%= f.text_area :message %>
    </div>

    <%= f.submit "Send", class: "btn" %>

  <% end %>

</div>