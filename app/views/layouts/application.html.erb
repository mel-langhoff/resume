<!DOCTYPE html>
<html>
  <head>
    <title>Mel Langhoff | Developer, Project Manager, Linguist</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=DM+Serif+Display&display=swap" rel="stylesheet">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>

    <!-- Favicon -->
    <%= favicon_link_tag 'favicon1.png' %>
  </head>

  <body class="page-background">

    <% unless content_for?(:full_screen) %>
      <%= render 'layouts/header' %>
    <% end %>

    <!-- ✅ FULL SCREEN (HOME PAGE) -->
    <% if content_for?(:full_screen) %>

      <%= yield :full_screen %>

    <% else %>

      <!-- ✅ NORMAL PAGES -->
      <main class="main-container">

        <% if content_for?(:page_title) %>
          <h1 class="page-title text-center mb-4">
            <%= yield :page_title %>
          </h1>
        <% end %>

        <div class="content-box">
          <%= yield %>
        </div>

      </main>

    <% end %>

    <% unless content_for?(:full_screen) %>
      <%= render 'layouts/footer' %>
    <% end %>

    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  </body>
</html>