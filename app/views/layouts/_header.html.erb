<div class="vending-machine">

  <!-- SLOT -->
  <div class="slot"></div>

  <!-- BOTTLES -->
  <div class="bottle-row">

    <%= link_to root_path, class: "bottle-link" do %>
      <%= image_tag "home.png", class: "bottle" %>
    <% end %>

    <%= link_to bio_path, class: "bottle-link" do %>
      <%= image_tag "about.png", class: "bottle" %>
    <% end %>

    <%= link_to resume_path, class: "bottle-link" do %>
      <%= image_tag "resume.png", class: "bottle" %>
    <% end %>

    <%= link_to projects_path, class: "bottle-link" do %>
      <%= image_tag "projects.png", class: "bottle" %>
    <% end %>

    <%= link_to "mailto:hello@mel-langhoff.com", class: "bottle-link" do %>
      <%= image_tag "contact.png", class: "bottle" %>
    <% end %>

  </div>

</div>